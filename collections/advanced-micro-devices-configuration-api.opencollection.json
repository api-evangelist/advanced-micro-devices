{
  "opencollection": "1.0.0",
  "info": {
    "name": "AMD Developer Cloud Configuration API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Configuration",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AMD ROCm Get ROCm Software Version",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.developer.amd.com/v1/system/rocm-version"
          },
          "docs": "Retrieve the installed ROCm platform version, HIP runtime version, and driver information."
        }
      ]
    }
  ],
  "bundled": true
}