  "info": {
    "_postman_id": "a8f1562c-d6bc-41cf-83e4-c0a817f58af3",
    "name": "AMD Developer Cloud Configuration Instances API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The AMD Developer Cloud API provides access to AMD Instinct GPU instances for AI inference, training, and HPC workloads. Supports managing compute instances, deploying AI models, monitoring GPU utilization, and integrating with ROCm-compatible frameworks including PyTorch, TensorFlow, and vLLM.\n\nContact Support:\n Name: AMD Developer Support",
      "type": "text/plain"
    }
