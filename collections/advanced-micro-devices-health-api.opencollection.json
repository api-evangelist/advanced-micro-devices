{
  "opencollection": "1.0.0",
  "info": {
    "name": "AMD Developer Cloud Configuration Health API",
    "version": "1"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-Key",
      "value": "{{X-API-Key}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Health",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "AMD ROCm Get GPU Device Health",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.developer.amd.com/v1/devices/:deviceId/health",
            "params": [
              {
                "name": "deviceId",
                "value": "",
                "type": "path",
                "description": "GPU device identifier."
              }
            ]
          },
          "docs": "Retrieve current health status, temperature, fan speed, and error counts for an AMD GPU device."
        }
      ]
    }
  ],
  "bundled": true
}