  "info": {
    "_postman_id": "05971b2c-32e0-4ae0-bf65-80f6b240650e",
    "name": "AMD ROCm Management API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The AMD ROCm Management API provides runtime monitoring and configuration for AMD GPU hardware running the ROCm software stack. Supports querying GPU device information, monitoring utilization and health, managing ROCm system configuration, and retrieving performance counters for AMD Instinct and Radeon GPUs.\n\nContact Support:\n Name: AMD ROCm Support",
      "type": "text/plain"
    }
  }
